<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.Build.NoTargets" Version="3.7.134" />
  <PropertyGroup>
    <!-- NoTargets imports the .NET SDK; restore needs framework metadata even though no assembly is compiled. -->
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Release</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <Target Name="CargoBuild" AfterTargets="Build">
    <Exec Command="cargo build --release --locked" WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>
  <Target Name="CargoClean" AfterTargets="Clean">
    <Exec Command="cargo clean --locked" WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.Build.NoTargets" Version="3.7.134" />
  <!-- Override SDK Publish after its import; ordinary Build never stages the shipped exe. -->
  <Target Name="Publish">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)release.ps1&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)target/dist/HWIDChecker.exe" DestinationFiles="$(MSBuildThisFileDirectory)../../HWIDChecker.exe" />
  </Target>
</Project>
